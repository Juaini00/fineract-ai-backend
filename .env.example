# Contoh konfigurasi Jarvis. Salin menjadi `.env` lalu isi nilai rahasianya.
# `.env` TIDAK PERNAH di-commit (lihat .gitignore).
#
# Angka operasional di bawah adalah NILAI AWAL dari docs/operations/runtime.md,
# bukan hasil tuning. Setiap angka punya alasan dan pemicu revisi di sana.

# ============================================================
# Aplikasi
# ============================================================
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=3007

APP_DATABASE_HOST=127.0.0.1
APP_DATABASE_PORT=5432
APP_DATABASE_USERNAME=root
APP_DATABASE_PASSWORD=password
APP_DATABASE_NAME=jarvis
APP_DATABASE_URL=postgres://root:password@127.0.0.1:5432/jarvis
# Local/dev saja. Startup aplikasi TIDAK PERNAH membuat atau mengubah tabel
# di lingkungan lain (database-design.md §7).
APP_DATABASE_MIGRATE_ON_STARTUP=true

# ============================================================
# Fineract — read-only / replika. JANGAN PERNAH menulis ke sini.
# ============================================================
FINERACT_DATABASE_HOST=127.0.0.1
FINERACT_DATABASE_PORT=5432
FINERACT_DATABASE_USERNAME=root
FINERACT_DATABASE_PASSWORD=password
FINERACT_DATABASE_NAME=fineract_default
FINERACT_DATABASE_URL=postgres://root:password@127.0.0.1:5432/fineract_default
FINERACT_DATABASE_MAX_CONNECTIONS=10
# Identitas deployment Fineract, direkam di chat_jobs.scope_json untuk audit (#7).
FINERACT_TENANT=default

# ============================================================
# Redis — hanya koordinasi SSE live. BUKAN sumber kebenaran (#3).
# ============================================================
REDIS_URL=redis://127.0.0.1:6380/0
REDIS_ENABLED=true

# ============================================================
# Autentikasi — Jarvis sebagai penerbit token (#7)
# HS256 sah HANYA selama Jarvis yang menerbitkan sekaligus memverifikasi.
# Bila kelak SSO/dashboard yang menerbitkan, WAJIB pindah ke asimetris
# (RS256/EdDSA + JWKS); secret simetris bersama berarti tiap layanan dapat
# mencetak token milik yang lain.
# ============================================================
JWT_ACCESS_SECRET=local-access-secret-change-me
JWT_REFRESH_SECRET=local-refresh-secret-change-me
JWT_ACCESS_TOKEN_EXPIRY_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRY_SECONDS=604800
# Wajib config, bukan konstanta kode (#7) — supaya pindah ke SSO tidak
# memerlukan perubahan kode.
JWT_ISSUER=jarvis
JWT_AUDIENCE=jarvis-api

AUTH_BOOTSTRAP_ADMIN_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=password123
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=strict
AUTH_REFRESH_COOKIE_PATH=/

# CORS dashboard web: origin yang diizinkan, dipisah koma.
# Kosong = mode pengembangan (izinkan seluruh origin loopback pada port apa pun).
# Production wajib mengisi origin frontend secara eksplisit, mis.
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com
CORS_ALLOWED_ORIGINS=

# CATATAN: API_KEY_* dan AUTH_BOOTSTRAP_ADMIN_TOKEN sengaja DIHAPUS.
# Tabel api_keys dibuang (#7); penyempitan office scope kini menjadi
# parameter request `office_ids[]` pada POST /chat/jobs.

# ============================================================
# LLM planner/composer
# ============================================================
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_CHAT_COMPLETIONS_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3
LLM_MAX_INPUT_TOKENS=16000
LLM_MAX_OUTPUT_TOKENS=2000
LLM_TEMPERATURE=0.1

# CATATAN: blok DEEPSEEK_* dan DEEPSEK_* (salah ketik, kurang satu E) dari
# repo lama sengaja DIHAPUS. Satu provider, satu set kunci.

# ============================================================
# Embedding — SATU klien, SATU jalur kode untuk dokumen dan query (#7).
# Perbedaan dokumen vs query HANYA pada input_type. Model Voyage bersifat
# asimetris: mengirim parameter berbeda antara sisi tulis dan sisi baca
# menurunkan kualitas peringkat tanpa satu pun sinyal kegagalan.
# ============================================================
EMBEDDING_PROVIDER=voyageai
EMBEDDING_BASE_URL=https://api.voyageai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-3-large
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_MS=30000
# Dibandingkan saat baca; tidak cocok → fail-closed ke arm leksikal (#7).
EMBEDDING_INPUT_TYPE_DOCUMENT=document
EMBEDDING_INPUT_TYPE_QUERY=query

VECTOR_STORE=pgvector
VECTOR_DATABASE_URL=postgres://root:password@127.0.0.1:5432/jarvis

# ============================================================
# Katalog pengetahuan
# ============================================================
CATALOG_PATH=knowledge
QUERY_PATH=queries
CATALOG_SYNC_ON_STARTUP=false

# ============================================================
# Worker lease & recovery (runtime.md §1)
# PRASYARAT K1: heartbeat WAJIB dari task Tokio independen. Bila ia hanya
# dipancarkan di batas node, satu node LLM worst case (30s × 3 retry = 90s)
# melebihi lease dan worker sehat akan dipagari di tengah kerja — saat itu
# WORKER_LEASE_DURATION_SECS wajib dinaikkan ke >= 180.
# ============================================================
# Proses tanpa worker tetap menerima job tetapi tidak pernah menjalankannya.
# integration-test.sh memakai ini untuk menguji semantik penerimaan tanpa
# balapan melawan worker.
WORKER_ENABLED=true
# Sementara: notifikasi Redis belum dipakai, jadi worker memeriksa antrean di
# PostgreSQL secara berkala. Setelah notifikasi ada, ini menjadi fallback.
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_DURATION_SECS=60
WORKER_LEASE_HEARTBEAT_INTERVAL_SECS=10
REAPER_INTERVAL_SECS=30
JOB_TTL_RUNNING_SECS=1800
CLARIFICATION_WAIT_LIMIT_SECS=7200
NODE_ATTEMPT_CAP=3
NODE_ATTEMPT_CAP_DETERMINISTIC=1

# ============================================================
# Klarifikasi (runtime.md §2)
# TTL opsi diturunkan dari clarification_forms.expires_at — bukan angka
# independen (K4).
# ============================================================
RESOLVER_PAGE_SIZE=25
RESOLVER_PAGE_SIZE_MAX=50
# Langit-langit paginasi di memori (I5: kelebihannya dinyatakan `truncated`,
# bukan dibuang). Pemicu revisi: begitu sebuah resolver rutin menyentuh batas
# ini pada halaman pertama, jawabannya adalah memberi resolver itu keyset
# SQL-side — bukan menaikkan angka ini.
RESOLVER_MAX_CANDIDATES=500
MAX_CLARIFICATION_STAGES=3
MAX_REVISIONS_PER_CLARIFICATION=10
MAX_FORMS_PER_JOB=20
MAX_RAW_TEXT_LENGTH=512

# ============================================================
# Idempotency (runtime.md §3)
# ============================================================
IDEMPOTENCY_TTL_SECS=86400
IDEMPOTENCY_KEY_MAX_LENGTH=255
IDEMPOTENCY_KEY_MIN_LENGTH=16

# ============================================================
# Dataset (runtime.md §4) — paling menunggu uji kapasitas
# ============================================================
CHUNK_ROWS=1000
CHUNK_MAX_BYTES=1048576
DATASET_MAX_ROWS=100000
DATASET_MAX_BYTES=67108864
JOB_RETAINED_BYTES_CAP=268435456
SESSION_RETAINED_BYTES_QUOTA=1073741824
DATASET_TTL_SECS=86400

# ============================================================
# Event & SSE (runtime.md §5)
# SSE_TRANSPORT_COMMENT_INTERVAL_SECS bukan bukti worker hidup — itu tugas
# lease. Aturan: nilainya < min(idle timeout tiap hop proxy) / 3.
# ============================================================
EVENT_REPLAY_RETENTION_DAYS=30
EVENT_INLINE_PAYLOAD_SOFT_BYTES=2048
EVENT_INLINE_PAYLOAD_HARD_BYTES=8192
SSE_FALLBACK_POLL_INTERVAL_SECS=2
SSE_FALLBACK_POLL_MAX_INTERVAL_SECS=15
SSE_TRANSPORT_COMMENT_INTERVAL_SECS=15
# Mode degradasi yang DIDUKUNG, bukan sakelar test: deployment yang tidak
# mengizinkan LISTEN (mis. pooler dalam mode transaction) menjalankannya dengan
# `false`. Stream tetap lengkap — ia sepenuhnya memakai fallback polling, dan
# integration test membuktikannya dengan assertion yang sama persis.
SSE_NOTIFICATIONS_ENABLED=true
SSE_OUTGOING_BUFFER_FRAMES=64
SSE_OUTGOING_BUFFER_BYTES=262144

# ============================================================
# Response & plan (runtime.md §6)
# ============================================================
MAX_BLOCKS_JSON_BYTES=262144
RESPONSE_RETENTION_DAYS=90
MAX_REPLAN_PER_JOB=2

# ============================================================
# Budget per job (runtime.md §6)
# BUDGET_MAX_COST sengaja kosong: ia DITURUNKAN dari cap token × tabel harga
# provider, tidak pernah dikonfigurasi independen.
# ============================================================
BUDGET_MAX_QUERIES=30
BUDGET_MAX_MODEL_CALLS=12
BUDGET_MAX_TOKENS=250000
PROBE_QUERY_TIMEOUT_MS=3000
ANALYTICAL_QUERY_TIMEOUT_MS=15000
NODE_OUTPUT_INLINE_THRESHOLD_BYTES=32768

# ============================================================
# Konfigurasi global PII (#15)
# Nilai runtime yang mengikat ada di tabel system_settings; variabel di bawah
# hanya SEED saat database masih kosong. Fail closed: bila tidak diketahui,
# PII dianggap mati.
# ============================================================
PII_ENABLED_SEED=false
PII_MODE_SEED=withhold

# ============================================================
# Observability
# ============================================================
RUST_LOG=info,tower_http=debug,sqlx=warn
